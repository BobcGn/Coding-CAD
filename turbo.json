{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".svelte-kit/output/**", "build/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
