{
  "name": "@coding-cad/implementation-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Reverse-engineer an existing source repository into Coding CAD Architecture IR.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "tsc -p tsconfig.json && node dist/analyzer.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@coding-cad/architecture-ir": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
