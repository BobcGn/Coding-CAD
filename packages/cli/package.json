{
  "name": "@coding-cad/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "coding-cad": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:integration && pnpm test:e2e",
    "test:integration": "tsc -p tsconfig.json && node dist/integration.test.js",
    "test:e2e": "tsc -p tsconfig.json && node dist/cli.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@coding-cad/architecture-dsl": "workspace:*",
    "@coding-cad/architecture-ir": "workspace:*",
    "@coding-cad/architecture-validator": "workspace:*",
    "@coding-cad/component-registry": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
