{
  "name": "@coding-cad/architecture-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Architecture reasoning layer for designing Architecture IR from user requirements.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
